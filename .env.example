# Configure in Hostinger Web App Environment Variables. Never commit real values.
NODE_ENV=production
RM_ADMIN_USER=admin
RM_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
RM_DB_PATH=/home/your-account/private/rm.sqlite3
OLLAMA_BASE_URL=https://your-ollama-endpoint.example
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma3:4b
TRUST_PROXY=1
RM_SESSION_SECONDS=28800
